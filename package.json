{
  "name": "rationauts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A colony-building game whose tech tree is the classical AI curriculum.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @rationauts/app dev",
    "build": "pnpm --filter @rationauts/app build",
    "preview": "pnpm --filter @rationauts/app preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.headless.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sim": "tsx packages/sim/src/cli.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
