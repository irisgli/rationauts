{
  "name": "@rationauts/sim",
  "version": "0.1.0",
  "description": "Scenario harness, replay and benchmark CLI for Rationauts.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "rationauts": "./src/cli.ts"
  },
  "dependencies": {
    "@rationauts/agents": "workspace:*",
    "@rationauts/core": "workspace:*"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "bin": {
      "rationauts": "./dist/cli.js"
    }
  }
}
